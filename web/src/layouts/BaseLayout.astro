---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";
import { apiFetch, forwardedCookies } from "../lib/api";

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}

const {
  title = "PetID — Identificación inteligente para mascotas",
  description = "El perfil digital de tu mascota, siempre al alcance de un QR.",
  noindex = false,
} = Astro.props;
const canonicalUrl = `https://www.petid.com.ar${Astro.url.pathname === "/" ? "/" : Astro.url.pathname.replace(/\/$/, "")}`;

const sessionResult = await apiFetch("/api/v1/me", {
  headers: forwardedCookies(Astro.request),
  cache: "no-store",
});
const authenticated = sessionResult.status === 200;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f7fbfd" />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {!noindex && <link rel="canonical" href={canonicalUrl} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://res.cloudinary.com" />
    <title>{title}</title>
  </head>
  <body>
    <Header authenticated={authenticated} />
    <slot />
    <Footer />
    <script is:inline>
      document.querySelectorAll("[data-password-toggle]").forEach((toggle) => {
        toggle.addEventListener("click", () => {
          const inputId = toggle.getAttribute("data-password-toggle");
          const input = inputId ? document.getElementById(inputId) : null;
          if (!(input instanceof HTMLInputElement)) return;
          const visible = input.type === "text";
          input.type = visible ? "password" : "text";
          toggle.textContent = visible ? "Mostrar" : "Ocultar";
          toggle.setAttribute(
            "aria-label",
            visible ? "Mostrar contraseña" : "Ocultar contraseña",
          );
        });
      });
    </script>
  </body>
</html>
