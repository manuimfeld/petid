---
type Name = "home" | "pets" | "user" | "arrow" | "map" | "whatsapp" | "edit" | "shield" | "scan" | "heart" | "check" | "camera" | "logout";

interface Props {
  name: Name;
  size?: number;
  strokeWidth?: number;
}

const { name, size = 21, strokeWidth = 2 } = Astro.props;
---

<svg class="icon" width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width={strokeWidth} stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {name === "home" && <><path d="m3 11 9-8 9 8"/><path d="M5 10v10h14V10"/><path d="M9 20v-6h6v6"/></>}
  {name === "pets" && <><circle cx="5.5" cy="8" r="2"/><circle cx="10" cy="5" r="2"/><circle cx="14" cy="5" r="2"/><circle cx="18.5" cy="8" r="2"/><path d="M8.2 13.1c1.8-2.1 5.8-2.1 7.6 0 2.3 2.7.2 6.2-3.8 6.2s-6.1-3.5-3.8-6.2Z"/></>}
  {name === "user" && <><circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0 1 16 0"/></>}
  {name === "arrow" && <><path d="M5 12h14"/><path d="m14 7 5 5-5 5"/></>}
  {name === "map" && <><path d="M20 10c0 5-8 11-8 11S4 15 4 10a8 8 0 1 1 16 0Z"/><circle cx="12" cy="10" r="2.5"/></>}
  {name === "whatsapp" && <><path d="M20.5 11.6a8.5 8.5 0 0 1-12.6 7.5L3 20.5l1.4-4.7A8.5 8.5 0 1 1 20.5 11.6Z"/><path d="M8.5 7.5c.3-.5.7-.5 1-.1l1 1.7c.2.4 0 .7-.3 1-.4.3-.5.6-.2 1.1.8 1.4 1.8 2.4 3.3 3.1.5.2.8.1 1.1-.3.3-.4.6-.8 1-.6l1.8.9c.5.2.5.6.3 1.1-.3.9-1.4 1.7-2.4 1.8-1.3.1-3.1-.6-5.1-2.4-2.2-2-3.3-4.2-3.1-5.5.1-.7.8-1.4 1.6-1.8Z"/></>}
  {name === "edit" && <><path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L8 18l-4 1 1-4Z"/></>}
  {name === "shield" && <><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10Z"/><path d="m9 12 2 2 4-5"/></>}
  {name === "scan" && <><path d="M3 7V4a1 1 0 0 1 1-1h3"/><path d="M17 3h3a1 1 0 0 1 1 1v3"/><path d="M21 17v3a1 1 0 0 1-1 1h-3"/><path d="M7 21H4a1 1 0 0 1-1-1v-3"/><path d="M7 8h2v2H7zM15 8h2v2h-2zM7 15h2v2H7zM13 13h4v4h-4z"/></>}
  {name === "heart" && <path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1.1-1.1a5.5 5.5 0 0 0-7.8 7.8l1.1 1.1L12 21l7.8-7.5 1.1-1.1a5.5 5.5 0 0 0-.1-7.8Z"/>}
  {name === "check" && <path d="m5 12 4 4L19 6"/>}
  {name === "camera" && <><path d="M14.5 5 13 3h-2L9.5 5H5a2 2 0 0 0-2 2v11a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2Z"/><circle cx="12" cy="12.5" r="4"/></>}
  {name === "logout" && <><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><path d="m16 17 5-5-5-5M21 12H9"/></>}
