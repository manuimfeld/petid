---
interface Props {
  province?: string | null;
  locality?: string | null;
  street?: string | null;
  streetNumber?: string | null;
}

const { province = "", locality = "", street = "", streetNumber = "" } = Astro.props;
const initialAddress = [street, streetNumber, locality, province].filter(Boolean).join(", ");
---

<div class="location-fields" data-location-fields>
  <div class="location-row">
    <label class="field"><span>Provincia</span><select class="input" name="province" required data-province><option value="">Cargando provincias…</option></select></label>
    <label class="field"><span>Localidad</span><select class="input" name="locality" required data-locality disabled><option value="">Elegí una provincia</option></select></label>
  </div>
  <div class="location-row">
    <label class="field"><span>Calle</span><input class="input" name="street" value={street} maxlength="180" placeholder="Ej. Av. Corrientes" required data-street /></label>
    <label class="field"><span>Altura</span><input class="input" name="streetNumber" value={streetNumber} maxlength="20" placeholder="Ej. 1234" required data-street-number /></label>
  </div>
  <input type="hidden" name="address" value={initialAddress} data-address />
  <p class="place-status">Escribí la calle y la altura. La dirección se mostrará tal como la completes.</p>
</div>

<script is:inline define:vars={{ province, locality }}>
  const root = document.currentScript?.previousElementSibling;
  const provinceSelect = root?.querySelector("[data-province]");
  const localitySelect = root?.querySelector("[data-locality]");
  const addressInput = root?.querySelector("[data-address]");
  const streetInput = root?.querySelector("[data-street]");
  const numberInput = root?.querySelector("[data-street-number]");
  const baseUrl = "https://apis.datos.gob.ar/georef/api";

  function syncAddress() {
    if (!addressInput) return;
    const parts = [streetInput?.value.trim(), numberInput?.value.trim(), localitySelect?.value, provinceSelect?.selectedOptions?.[0]?.textContent].filter(Boolean);
    addressInput.value = parts.join(", ");
  }

  async function loadLocalities(provinceId) {
    localitySelect.disabled = true;
    localitySelect.replaceChildren(new Option("Cargando localidades…", ""));
    try {
      const response = await fetch(`${baseUrl}/localidades?provincia=${encodeURIComponent(provinceId)}&max=5000&orden=nombre`);
      const data = await response.json();
      localitySelect.replaceChildren(new Option("Seleccioná una localidad", ""));
      data.localidades.forEach((item) => localitySelect.append(new Option(item.nombre, item.nombre)));
      const selected = [...localitySelect.options].find((option) => option.value === locality);
      if (selected) localitySelect.value = selected.value;
      localitySelect.disabled = false;
      syncAddress();
    } catch {
      localitySelect.replaceChildren(new Option("No se pudieron cargar", ""));
    }
  }

  async function loadProvinces() {
    try {
      const response = await fetch(`${baseUrl}/provincias?max=100&orden=nombre`);
      const data = await response.json();
      provinceSelect.replaceChildren(new Option("Seleccioná una provincia", ""));
      data.provincias.forEach((item) => provinceSelect.append(new Option(item.nombre, item.id)));
      const selected = [...provinceSelect.options].find((option) => option.textContent === province);
      if (selected) {
        provinceSelect.value = selected.value;
        await loadLocalities(selected.value);
      }
    } catch {
      provinceSelect.replaceChildren(new Option("No se pudieron cargar", ""));
    }
  }

  provinceSelect?.addEventListener("change", (event) => {
    if (event.target.value) loadLocalities(event.target.value);
    syncAddress();
  });
  [streetInput, numberInput, localitySelect].forEach((input) => input?.addEventListener("input", syncAddress));
  loadProvinces();
</script>

<style>
  .location-fields { display: grid; gap: 12px; }
  .location-row { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
  .field { display: grid; gap: 6px; }
  .field > span { font-size: .85rem; font-weight: 700; }
  .place-status { margin: 0; color: var(--muted); font-size: .72rem; }
  @media (max-width: 520px) { .location-row { grid-template-columns: 1fr; } }
</style>
