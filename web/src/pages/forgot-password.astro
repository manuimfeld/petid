---
import Icon from "../components/Icon.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { API_URL } from "../lib/api";
---

<BaseLayout title="Recuperar contraseña — PetID" noindex>
  <main class="page narrow-page auth-page">
    <section class="auth-intro fade-up">
      <span class="mini-mark"><Icon name="shield" size={28} /></span>
      <p class="eyebrow">Recuperar acceso</p>
      <h1>Volvé a tu cuenta</h1>
      <p class="lead">También podés usar este flujo para crear una contraseña si antes ingresabas solamente con Google.</p>
    </section>

    <section class="card form-card fade-up" style="--delay: 80ms">
      <form id="forgot-form" class="form-grid">
        <div class="field">
          <label for="email">Email</label>
          <input class="input" id="email" name="email" type="email" autocomplete="email" placeholder="tu@email.com" required />
        </div>
        <div class="form-message" id="form-message" role="status"></div>
        <button class="button button-primary button-full" type="submit">Enviar enlace <Icon name="arrow" /></button>
      </form>
      <p class="auth-switch"><a href="/login">Volver a ingresar</a></p>
    </section>
  </main>
</BaseLayout>

<script is:inline define:vars={{ API_URL }}>
  const form = document.querySelector("#forgot-form");
  const message = document.querySelector("#form-message");
  const emailInput = document.querySelector("#email");
  const presetEmail = new URLSearchParams(window.location.search).get("email");
  if (presetEmail && emailInput) emailInput.value = presetEmail;

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    const button = form.querySelector("button[type='submit']");
    const values = new FormData(form);
    button.disabled = true;
    message.dataset.visible = "false";

    try {
      const response = await fetch(`${API_URL}/api/auth/request-password-reset`, {
        method: "POST",
        credentials: "include",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          email: values.get("email"),
          redirectTo: `${window.location.origin}/reset-password`,
        }),
      });
      const data = await response.json().catch(() => ({}));
      if (!response.ok) throw new Error(data.message || "No pudimos enviar el enlace.");
      message.textContent = "Si existe una cuenta con ese email, vas a recibir un enlace en unos minutos.";
      message.dataset.type = "success";
      message.dataset.visible = "true";
      form.reset();
    } catch (error) {
      message.textContent = error instanceof Error ? error.message : "No pudimos conectar con la API.";
      message.dataset.type = "error";
      message.dataset.visible = "true";
    } finally {
      button.disabled = false;
    }
  });
</script>

<style>
  .auth-page { padding-top: 34px; }
  .auth-intro { text-align: center; }
  .auth-intro h1 { font-size: clamp(2.15rem, 10vw, 3.4rem); }
  .mini-mark { display: grid; width: 56px; height: 56px; place-items: center; margin: 0 auto 20px; border-radius: 19px; color: var(--sky-700); background: var(--sky-100); transform: rotate(-5deg); }
  .auth-switch { margin: 0; text-align: center; }
  .auth-switch a { color: var(--sky-700); font-size: .8rem; font-weight: 800; }
</style>
